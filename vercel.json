{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/team", "destination": "/team/index.html" },
    { "source": "/casino", "destination": "/casino/index.html" },
    { "source": "/tournament", "destination": "/tournament/index.html" },
    { "source": "/wishlist", "destination": "/wishlist/index.html" },
